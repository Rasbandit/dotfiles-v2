#!/bin/bash
# GameMode start/end hook (see ~/.config/gamemode.ini [custom]).
#
# Fedora's GameMode polkit policy denies cpugovctl to a normal user, so GameMode registers
# games but never changes the CPU. tuned stays the single owner of power state; this hook
# flips the tuned profile instead. gamemoded refcounts clients: `start` fires on the first
# game, `end` after the last.
#
#   gamemode-hook start   save the active tuned profile, switch to the game profile
#   gamemode-hook end     restore the saved profile
#
# Per-machine override (optional): ~/.config/gamemode-hook.conf  →  GAME_PROFILE=...
# No tuned-adm on this machine → quietly does nothing.
set -u

GAME_PROFILE=throughput-performance
# shellcheck disable=SC1090
[[ -r $HOME/.config/gamemode-hook.conf ]] && . "$HOME/.config/gamemode-hook.conf"

command -v tuned-adm >/dev/null 2>&1 || exit 0

# Dual-CCD X3D CPUs (e.g. 9900X3D): the amd_x3d_vcache driver steers scheduling toward either the
# V-Cache CCD ("cache") or the high-clock CCD ("frequency"). Games want "cache" while they run.
# File absent on other CPUs: the whole block is skipped.
X3D_MODE=/sys/bus/platform/drivers/amd_x3d_vcache/AMDI0101:00/amd_x3d_mode
X3D_PREV="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gamemode-prev-x3d-mode"
x3d_set() { sudo -n /usr/bin/tee "$X3D_MODE" <<<"$1" >/dev/null || logger -t gamemode-hook "failed to set x3d mode $1"; }

PREV_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gamemode-prev-tuned-profile"
active_profile() { tuned-adm active 2>/dev/null | sed 's/.*: //'; }

case "${1:-}" in
  start)
    cur=$(active_profile)
    if [[ -n $cur && $cur != "$GAME_PROFILE" ]]; then
      echo "$cur" > "$PREV_FILE"
    fi
    sudo -n tuned-adm profile "$GAME_PROFILE" || logger -t gamemode-hook "failed to set $GAME_PROFILE"
    if [[ -w /dev/null && -r $X3D_MODE ]]; then
      xcur=$(<"$X3D_MODE")
      [[ $xcur != cache ]] && { echo "$xcur" > "$X3D_PREV"; x3d_set cache; }
    fi
    ;;
  end)
    if [[ -f $X3D_PREV ]]; then
      xprev=$(<"$X3D_PREV")
      [[ $xprev =~ ^(frequency|cache)$ ]] && x3d_set "$xprev"
      rm -f "$X3D_PREV"
    fi
    [[ -f $PREV_FILE ]] || exit 0
    prev=$(<"$PREV_FILE")
    # Only ever restore a plain profile name (it feeds a sudo command).
    if [[ $prev =~ ^[a-z][a-z-]*$ ]]; then
      sudo -n tuned-adm profile "$prev" || logger -t gamemode-hook "failed to restore $prev"
    fi
    rm -f "$PREV_FILE"
    ;;
  *)
    echo "usage: ${0##*/} start|end" >&2
    exit 1
    ;;
esac
