# Files to ignore (not managed by chezmoi)
README.md
LICENSE
CLAUDE.md
TOOLS.md
docs/
.watched-paths
ansible/
bootstrap.sh

# Ignore machine-specific generated files
.bash_history
.cache/
.local/share/
.local/state/

# IDE/editor files
.vscode/
*.swp
*~

# Continue extension config — only deploy when vscode feature is selected
{{- $features := "" }}
{{- $featuresFile := joinPath .chezmoi.homeDir ".config/chezmoi/features" }}
{{- if stat $featuresFile }}
{{-   $features = include $featuresFile }}
{{- end }}
{{- if not (contains "vscode" $features) }}
.continue/
{{- end }}
{{- if not (contains "gaming-desktop" $features) }}
.evmapy/
.config/autostart/evmapy.desktop
.config/MangoHud/
.config/systemd/user/esde-chmod-watcher.path
.config/systemd/user/esde-chmod-watcher.service
.config/systemd/user/evmapy.service
.config/systemd/user/gcadapter-evdev@.service
.config/systemd/user/gcadapter-nav.service
.local/bin/focus_es-de.sh
.local/bin/gcadapter-nav
.local/bin/spotify-controll.sh
.config/systemd/user/gnome-keyring-daemon.service
.config/systemd/user/gnome-keyring-daemon.socket
{{- end }}
