Host homeassistant
  Hostname 10.0.20.203
  Port 22
  User homeassistant

Host claw
  Hostname 10.0.20.172
  Port 22
  User open-claw

Host *
  IdentityAgent ~/.1password/agent.sock

# Self-hosted Actions runner VM (Ubuntu 24.04 on SlowRaid)
# Via SSH port-forward 10.0.20.201:2222 -> 10.20.99.10:22
Host gh-runner
    HostName 10.0.20.201
    Port 2222
    User github-runner
    StrictHostKeyChecking accept-new

Host gaming-pc
  HostName 10.0.20.210
  User rasbandit

# Gaming-PC runner VM (libvirt NAT on gaming-pc, 10.20.98.10)
Host gpc-runner
    HostName 10.20.98.10
    User github-runner
    ProxyJump gaming-pc
    StrictHostKeyChecking accept-new

# Mini PC (hosts minipc-runner-vm). Remote toggle: ssh -i ~/.ssh/id_ed25519_gpc_ci rasbandit@10.0.20.184 status
Host mini-pc
  HostName 10.0.20.135
  User rasbandit
  IdentityAgent none
  IdentityFile ~/.ssh/id_ed25519_minipc
  IdentitiesOnly yes

# Mini-PC runner VM (libvirt NAT on mini-pc, 10.20.97.10)
Host minipc-runner
    HostName 10.20.97.10
    User github-runner
    ProxyJump mini-pc
    StrictHostKeyChecking accept-new
