{
  "Listeners" : ["UDP:9000", "UDP:7000", "HTTP:8009"],
  "LogLevel" : "INFO",
  "ExitIfAnyPortIsAlreadyUsed" : true,
  "AvoidDualUDPSending" : {
    "Active": false,
    "Delay": "100ms"
  },
  "Commands" : [
    {
      "Operation" : "halt",
      "Command" : "shutdown now"
    },
    {
      "Operation" : "left",
      "Command" : "ydotool key 105:1 105:0"
    },
    {
      "Operation" : "up",
      "Command" : "ydotool key 103:1 103:0"
    },
    {
      "Operation" : "right",
      "Command" : "ydotool key 106:1 106:0"
    },
    {
      "Operation" : "down",
      "Command" : "ydotool key 108:1 108:0"
    },
    {
      "Operation" : "enter",
      "Command" : "ydotool key 28:1 28:0"
    },
    {
      "Operation" : "back",
      "Command" : "ydotool key 14:1 14:0"
    },
    {
      "Operation" : "esc",
      "Command" : "ydotool key 1:1 1:0"
    },
    {
      "Operation" : "home",
      "Command" : "/home/rasbandit/.local/bin/focus_es-de.sh &"
    }
  ]
